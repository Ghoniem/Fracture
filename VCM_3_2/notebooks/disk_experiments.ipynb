    "# =======================\n",
    "# Post-run crack energetics (phase-transition view)\n",
    "# =======================\n",
    "from fracture_utils.Ubem.crack_energetics import (\n",
    "    EnergeticsConfig,\n",
    "    aggregate_growth_path,\n",
    "    compute_force_control_energetics,\n",
    "    plot_energetics_vs_length,\n",
    "    save_energetics_npz,\n",
    ")\n",
    "\n",
    "def _total_length_from_id_arrays(vertices, connectivity):\n",
    "    vv = np.asarray(vertices, float)\n",
    "    cc = np.asarray(connectivity, int)\n",
    "    if cc.size == 0:\n",
    "        return 0.0\n",
    "    pos = {int(row[0]): np.array([float(row[1]), float(row[2])], float) for row in vv}\n",
    "    total = 0.0\n",
    "    for v0, v1 in cc:\n",
    "        p0 = pos[int(v0)]\n",
    "        p1 = pos[int(v1)]\n",
    "        total += float(np.linalg.norm(p1 - p0))\n",
    "    return float(total)\n",
    "\n",
    "tip_hist_path = run_dir / \"tip_sif_history_all_cycles.npz\"\n",
    "if not tip_hist_path.exists():\n",
    "    raise FileNotFoundError(f\"tip history not found: {tip_hist_path}\")\n",
    "\n",
    "with np.load(tip_hist_path, allow_pickle=True) as npz:\n",
    "    tip_hist_data = {k: npz[k] for k in npz.files}\n",
    "\n",
    "a0_m = _total_length_from_id_arrays(VERTICES, CONNECTIVITY)\n",
    "\n",
    "growth_path = aggregate_growth_path(\n",
    "    tip_hist_data,\n",
    "    include_initial=True,\n",
    "    initial_total_length_m=a0_m,\n",
    ")\n",
    "\n",
    "ener_cfg = EnergeticsConfig(\n",
    "    E=float(GROWTH_PARAMS[\"material_E\"]),\n",
    "    nu=float(GROWTH_PARAMS[\"material_nu\"]),\n",
    "    plane_stress=bool(GROWTH_PARAMS[\"plane_stress\"]),\n",
    "    P=float(disk.P_total),\n",
    "    thickness=float(disk.h),\n",
    "    fracture_surfaces=2.0,\n",
    "    compliance_C0=0.0,\n",
    ")\n",
    "\n",
    "ener = compute_force_control_energetics(growth_path, cfg=ener_cfg)\n",
    "ener_npz = save_energetics_npz(run_dir / \"crack_energetics_vs_a.npz\", ener)\n",
    "print(f\"[energetics-npz] {ener_npz}\")\n",
    "print(f\"[energetics] using effective force-control load P = {ener_cfg.P:.6g} N\")\n",
    "\n",
    "plot_paths = plot_energetics_vs_length(\n",
    "    ener,\n",
    "    out_dir=run_dir,\n",
    "    show=True,\n",
    "    prefix=\"crack_energetics\",\n",
    ")\n",
    "for key, p in plot_paths.items():\n",
    "    print(f\"[energetics-plot:{key}] {p}\")\n"
   ]
  }
